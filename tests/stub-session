#!/usr/bin/env bash
#
# Stands in for `claude` while the runner's own tests run.
#
# Each invocation consumes one line of $STUB_PLAN and does to the ticket what
# that session would have done:
#
#   build        set status: done, write a Left standing that names something -
#                with $STUB_LEFT_EXTRA's contents after it, where it names a
#                file - and commit it with the code
#   build-dirty  build, and leave an untracked file behind besides
#   build-killed build, then kill the runner with -9 before it can check the build
#   build-red    build, and leave .red at the root, which a test's check reads
#                as red
#   build-red-killed  build-red, then kill the runner with -9 before it can
#                check the build
#   fix-red      remove .red, commit a fix, and set status: done again - the
#                resumed session a red check was handed back to
#   claim-only   set status: done having committed nothing
#   claim-dirty  the same, with code written and left uncommitted
#   claim-killed set status: done, commit nothing, and kill the runner with -9
#   code-only    set status: done, and commit the code but not the ticket
#   halt:<kind>  write the halt, two paragraphs, and set status: halted - with
#                $STUB_HALT_EXTRA's contents after them, where it names a file
#   die          exit 1 having touched nothing, as a crash does
#   stop-early   write code and leave it uncommitted, the ticket at `doing`, and
#                exit 0 - a session that ended its turn waiting on background
#                work, which `-p` then killed
#   limit        be rejected by a usage limit, in the events the CLI really
#                writes: a rejected rate_limit_event carrying the reset time,
#                the assistant's rate_limit error, and an error result
#   limit-quiet  only the rejected rate_limit_event, with no text anywhere
#   limit-bare   only the assistant's rate_limit error, with no reset time
#   build-limit  build, then be stopped by a limit
#   limit-sub    a subagent hits a limit, then the session dies of something else
#   limit-passed a subagent hits a limit and the session is told of a rejected
#                window, but it goes on to finish - then `build`
#   killed       write code, then kill the runner with -9 - it gets no chance to
#                tidy up, as with a power cut or a closed laptop
#   review       the final review - write and commit the REVIEW.md its prompt
#                names, and end in a successful result, as the CLI does
#   review-dies  the final review, dying with no REVIEW.md and no result
#   review-stop-early  the final review, ending in a successful result with no
#                REVIEW.md - a review that ended its turn waiting on a subagent
#   orphaned     write code, kill the runner with -9, and keep running a while -
#                a session outliving the runner that launched it
#
# The call that looks for the project's checks is told apart by the schema it
# asks its answer in, consumes no plan line and is not recorded: it answers
# $STUB_VERIFY as the command, or no command at all where that is empty.
#
# Every call's arguments go to $STUB_ARGS, the verification call's included, with
# the prompt it read on stdin after them.
#
# Every other call reads context the way the CLI reports it, for the token log:
# 111 in its own context, on one message written twice as the CLI repeats a
# message once per content block, and 1000 in a subagent's.
#
# Every call's session is written to $STUB_SESSIONS as `start <id> <ticket>` or
# `resume <id>` - the final review's start naming its REVIEW.md where a build's
# names its ticket. A resumed call names neither in its prompt - the real session
# remembers what it was doing - so the stub looks it up by the id.
#
# There is one role now where there were two. The runner used to launch a second
# session to review what the first built; `/implement` spawns that reviewer
# itself, so a plan line no longer has to say which of the two is being answered.
#
# A call the plan did not expect is an error rather than a repeat: a test that
# cares how often the runner calls out needs the extra call to be visible.

set -uo pipefail

prompt="$(cat)"

# Every call's arguments, one line each, for the tests that care how the
# runner launches a session rather than what the session did - led by the one
# environment variable the runner sets for it, and followed by the prompt.
printf 'ENABLE_CLAUDEAI_MCP_SERVERS=%s %s | %s\n' "${ENABLE_CLAUDEAI_MCP_SERVERS-}" "$*" "${prompt//$'\n'/ }" >> "$STUB_ARGS"

if [[ " $* " == *" --json-schema "* ]]; then
  jq -nc --arg c "$STUB_VERIFY" \
    '{type: "result", subtype: "success", is_error: false}
     + if $c == "" then {} else {structured_output: {command: $c}} end'
  exit 0
fi

ticket="$(printf '%s' "$prompt" | grep -o '[^ ]*tickets/[^ ]*\.md' | head -1)"
review="$(printf '%s' "$prompt" | grep -o '[^ `]*REVIEW\.md' | head -1)"

args=("$@")
for i in "${!args[@]}"; do
  case "${args[$i]}" in
    --session-id) printf 'start %s %s\n' "${args[$((i + 1))]}" "${ticket:-$review}" >> "$STUB_SESSIONS" ;;
    --resume)     id="${args[$((i + 1))]}"
                  printf 'resume %s\n' "$id" >> "$STUB_SESSIONS"
                  ticket="$(awk -v id="$id" '$1 == "start" && $2 == id { print $3 }' "$STUB_SESSIONS")"
                  case "$ticket" in *REVIEW.md) review="$ticket"; ticket="" ;; esac ;;
  esac
done

# One line per call, whitespace flattened, so a test can count calls and read
# the first one to see which ticket went first.
n=$(( $(wc -l < "$STUB_CALLS") + 1 ))
printf '%s\n' "$prompt" | tr '\n' ' ' >> "$STUB_CALLS"
printf '\n' >> "$STUB_CALLS"

line="$(sed -n "${n}p" "$STUB_PLAN")"
[ -n "$line" ] || { echo "stub: no plan line $n for: $prompt" >&2; exit 99; }

echo '{"type":"assistant","message":{"id":"msg_main","content":[],"usage":{"input_tokens":1,"cache_read_input_tokens":10,"cache_creation_input_tokens":100,"output_tokens":5}},"parent_tool_use_id":null}'
echo '{"type":"assistant","message":{"id":"msg_main","content":[],"usage":{"input_tokens":1,"cache_read_input_tokens":10,"cache_creation_input_tokens":100,"output_tokens":5}},"parent_tool_use_id":null}'
echo '{"type":"assistant","message":{"id":"msg_sub","content":[],"usage":{"input_tokens":1000,"cache_read_input_tokens":0,"cache_creation_input_tokens":0,"output_tokens":5}},"parent_tool_use_id":"toolu_sub"}'

# Resetting $STUB_RESET_IN seconds from now, 0 unless a test says otherwise.
rejected_event() {
  printf '{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","resetsAt":%s,"rateLimitType":"five_hour"}}\n' \
    "$(( $(date +%s) + ${STUB_RESET_IN:-0} ))"
}

set_status() { sed -i "2,/^---$/s/^status: .*/status:    $1/" "$ticket"; }

case "$line" in
  review|review-dies|review-stop-early)
    # The final review names no ticket, which is how the stub tells it apart.
    [ -n "$ticket" ] && { echo "stub: expected the review, got a ticket: $prompt" >&2; exit 97; }
    [ "$line" = review-dies ] && exit 1
    if [ "$line" = review-stop-early ]; then
      echo '{"type":"result","subtype":"success","is_error":false,"result":"waiting for critique"}'
      exit 0
    fi
    printf '## For you\n\n1. the review left: a seam\n\n## Findings\n\nthe review'"'"'s detail\n' > "$review"
    git add "$review" >/dev/null 2>&1
    git commit -qm "review" >/dev/null 2>&1
    echo '{"type":"result","subtype":"success","is_error":false,"result":"reviewed"}'
    ;;
  build|limit-passed|build-limit|build-dirty|build-killed|build-red|build-red-killed)
    if [ "$line" = limit-passed ]; then
      echo '{"type":"assistant","message":{"role":"assistant","content":[]},"parent_tool_use_id":"toolu_sub","error":"rate_limit"}'
      rejected_event
      echo '{"type":"result","subtype":"success","is_error":false,"result":"built"}'
    fi
    printf '\n## Left standing\n\n- left by %s\n' "$(basename "$ticket")" >> "$ticket"
    [ -z "${STUB_LEFT_EXTRA:-}" ] || cat "$STUB_LEFT_EXTRA" >> "$ticket"
    set_status "done"
    git add -A >/dev/null 2>&1
    git commit -qm "build $(basename "$ticket")" >/dev/null 2>&1
    if [ "$line" = build-limit ]; then rejected_event; exit 1; fi
    case "$line" in build-red*) : > "$(git rev-parse --show-toplevel)/.red" ;; esac
    if [ "$line" = build-killed ] || [ "$line" = build-red-killed ]; then kill -9 "$PPID"; fi
    if [ "$line" = build-dirty ]; then printf 'stray\n' > "$(git rev-parse --show-toplevel)/stray"; fi
    ;;
  fix-red)
    rm -f "$(git rev-parse --show-toplevel)/.red"
    printf 'fixed\n' >> "$(git rev-parse --show-toplevel)/fix"
    set_status "done"
    git add -A >/dev/null 2>&1
    git commit -qm "fix $(basename "$ticket")" >/dev/null 2>&1
    ;;
  claim-only|claim-dirty|claim-killed)
    [ "$line" != claim-dirty ] || printf 'half\n' > "$(git rev-parse --show-toplevel)/code"
    printf 'built\n' >> "$ticket"
    set_status "done"
    [ "$line" != claim-killed ] || kill -9 "$PPID"
    ;;
  code-only)
    printf 'built\n' > code
    git add code >/dev/null 2>&1
    git commit -qm "build $(basename "$ticket")" >/dev/null 2>&1
    set_status "done"
    ;;
  halt:*)
    printf '\n## Halt\n\n%s - the stub was told to\n\nsecond line of the halt\n' "${line#halt:}" >> "$ticket"
    [ -z "${STUB_HALT_EXTRA:-}" ] || cat "$STUB_HALT_EXTRA" >> "$ticket"
    set_status halted
    ;;
  die) exit 1 ;;
  orphaned)
    printf 'half\n' > "$(git rev-parse --show-toplevel)/code"
    kill -9 "$PPID"
    /bin/sleep 3
    ;;
  killed)
    printf 'half\n' > "$(git rev-parse --show-toplevel)/code"
    kill -9 "$PPID"
    ;;
  stop-early) printf 'half\n' > "$(git rev-parse --show-toplevel)/code" ;;
  limit-sub)
    echo '{"type":"assistant","message":{"role":"assistant","content":[]},"parent_tool_use_id":"toolu_sub","error":"rate_limit"}'
    exit 1
    ;;
  limit)
    rejected_event
    echo '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"You'"'"'ve hit your session limit · resets 2:10am (Europe/Amsterdam)"}]},"parent_tool_use_id":null,"error":"rate_limit"}'
    echo '{"type":"result","subtype":"success","is_error":true,"terminal_reason":"api_error","result":"You'"'"'ve hit your session limit · resets 2:10am (Europe/Amsterdam)"}'
    exit 1
    ;;
  limit-quiet) rejected_event; exit 1 ;;
  limit-bare)
    echo '{"type":"assistant","message":{"role":"assistant","content":[]},"parent_tool_use_id":null,"error":"rate_limit"}'
    exit 1
    ;;
  *) echo "stub: bad plan line: $line" >&2; exit 98 ;;
esac
