#!/usr/bin/env bash
#
# Stands in for `claude` while the runner's own tests run.
#
# Each invocation consumes one line of $STUB_PLAN:
#
#   <implement|critique> <outcome>
#
# and does to the ticket what that session would have done:
#
#   implement review      commit, and set status: review
#   implement claim-only  set status: review having committed nothing
#   implement halt:<kind> write the halt and set status: halted
#   implement die         exit 1 having touched nothing, as a crash does
#   implement limit       exit with the usage-limit message on stdout
#   critique  clean       say so, and touch nothing
#   critique  findings    write ## Findings into the ticket
#
# A call the plan did not expect is an error rather than a repeat: a test that
# cares how often the runner calls out needs an extra call to be visible.

set -uo pipefail

prompt="${*: -1}"
ticket="$(printf '%s' "$prompt" | grep -o '[^ ]*tickets/[^ ]*\.md' | head -1)"
n=$(( $(wc -l < "$STUB_CALLS") + 1 ))
printf '%s\n' "$prompt" | tr '\n' ' ' >> "$STUB_CALLS"
printf '\n' >> "$STUB_CALLS"

line="$(sed -n "${n}p" "$STUB_PLAN")"
[ -n "$line" ] || { echo "stub: no plan line $n for: $prompt" >&2; exit 99; }
role="${line%% *}" outcome="${line#* }"

set_status() { sed -i "s/^status: .*/status:    $1/" "$ticket"; }

case "$role:$outcome" in
  implement:review)
    printf 'built\n' >> "$ticket"
    set_status review
    git -C "$(dirname "$ticket")/../.." add -A >/dev/null 2>&1
    git -C "$(dirname "$ticket")/../.." commit -qm "build $(basename "$ticket")" >/dev/null 2>&1
    ;;
  implement:claim-only)
    printf 'built\n' >> "$ticket"
    set_status review
    ;;
  implement:halt:*)
    printf '\n## Halt\n\n%s - the stub was told to\n' "${outcome#halt:}" >> "$ticket"
    set_status halted
    ;;
  implement:die) exit 1 ;;
  implement:limit)
    echo "Claude usage limit reached. Your limit will reset at 9pm."
    exit 1
    ;;
  critique:clean) echo "0 blockers 0 majors 0 minors 0 nits" ;;
  critique:findings)
    printf '\n## Findings\n\n- the stub found something\n' >> "$ticket"
    echo "1 blockers 0 majors 0 minors 0 nits"
    ;;
  *) echo "stub: bad plan line: $line" >&2; exit 98 ;;
esac
