#!/usr/bin/env bash
#
# Stands in for `claude` while the runner's own tests run.
#
# Each invocation consumes one line of $STUB_PLAN and does to the chunk what
# that session would have done:
#
#   build        set status: done, write a Left standing that names something -
#                with $STUB_LEFT_EXTRA's contents after it, where it names a
#                file - and commit it with the code
#   build-declare  build, and declare $STUB_DECLARE as one of the project's
#                checks in CLAUDE.md, in the same commit, on a line named
#                $STUB_DECLARE_AS - `Slow check`, without its colon - and on a
#                Check: line where that is not set
#   build-refused  build, ending in a result whose permission_denials name an
#                Edit under .claude/, a Bash command of two lines and one longer
#                than a narrated line, as the CLI reports a call it would not
#                run - the first Bash one preceded by the event that gives the
#                classifier's reason, the others by none
#   build-journey  build, and add a step to journeys/one.md in the same commit
#   build-dirty  build, and leave an untracked file behind besides
#   build-killed build, then kill the runner with -9 before it can check the build
#   build-red    build, and leave .red at the root, which a test's check reads
#                as red
#   build-red-killed  build-red, then kill the runner with -9 before it can
#                check the build
#   fix-red      remove .red, commit a fix, and set status: done again - the
#                resumed session a red check was handed back to, a build's or
#                the final review's
#   fix-uncommitted  write a file named fix and leave it uncommitted, then exit
#                0 - a resumed session that fixed a red check and stopped short of
#                committing the fix
#   claim-only   set status: done having committed nothing
#   claim-dirty  the same, with code written and left uncommitted
#   claim-killed set status: done, commit nothing, and kill the runner with -9
#   code-only    set status: done, and commit the code but not the chunk
#   halt:<kind>  write the halt, two paragraphs, and set status: halted - with
#                $STUB_HALT_EXTRA's contents after them, where it names a file
#   die          exit 1 having touched nothing, as a crash does
#   stop-early   write code and leave it uncommitted, the chunk at `doing`, and
#                exit 0 - a session that ended its turn waiting on background
#                work, which `-p` then killed
#   commit-stop  commit code, leave the chunk at `doing` and nothing
#                uncommitted, and exit 0 - a session that committed its build
#                and ended its turn on the checks it had started
#   limit        be rejected by a usage limit, in the events the CLI really
#                writes: a rejected rate_limit_event carrying the reset time,
#                the assistant's rate_limit error, and an error result
#   limit-quiet  only the rejected rate_limit_event, with no text anywhere
#   limit-bare   only the assistant's rate_limit error, with no reset time
#   build-limit  build, then be stopped by a limit
#   limit-sub    a subagent hits a limit, then the session dies of something else
#   limit-passed a subagent hits a limit and the session is told of a rejected
#                window, but it goes on to finish - then `build`
#   killed       write code, then kill the runner with -9 - it gets no chance to
#                tidy up, as with a power cut or a closed laptop
#   split-none   the split, finding that the change fits one agent: writes nothing
#   split-two    the split, writing two chunks of the change - one per journey,
#                the second after the first - and committing them
#   split-dirty  split-two, leaving the chunks uncommitted
#   review       the final review - write and commit the REVIEW.md its prompt
#                names, and end in a successful result, as the CLI does
#   review-red   the final review, and leave .red at the root besides
#   review-journey  the final review, then add a step to journeys/one.md and
#                commit that too
#   review-dies  the final review, dying with no REVIEW.md and no result
#   review-stop-early  the final review, ending in a successful result with no
#                REVIEW.md - a review that ended its turn waiting on a subagent
#   orphaned     write code, kill the runner with -9, and keep running a while -
#                a session outliving the runner that launched it
#
# The call that looks for the project's checks is told apart by the schema it
# asks its answer in, consumes no plan line and is not recorded: it answers
# $STUB_VERIFY as the command, or no command at all where that is empty.
#
# Every call's arguments go to $STUB_ARGS, the verification call's included, with
# the prompt it read on stdin after them.
#
# Every other call reads context the way the CLI reports it, for the token log:
# 111 in its own context, on one message written twice as the CLI repeats a
# message once per content block, and 1000 in a subagent's.
#
# Every call's session is written to $STUB_SESSIONS as `start <id> <chunk>` or
# `resume <id>` - the final review's start naming its REVIEW.md where a build's
# names its chunk. A started call is told apart by how its brief opens, and
# one that opens neither way is an error. A resumed call names neither in its
# prompt - the real session remembers what it was doing - so the stub looks it
# up by the id.
#
# There is one role now where there were two. The runner used to launch a second
# session to review what the first built; `/implement` spawns that reviewer
# itself, so a plan line no longer has to say which of the two is being answered.
#
# A call the plan did not expect is an error rather than a repeat: a test that
# cares how often the runner calls out needs the extra call to be visible.

set -uo pipefail

prompt="$(cat)"

# Every call's arguments, one line each, for the tests that care how the
# runner launches a session rather than what the session did - followed by the
# prompt.
printf '%s | %s\n' "$*" "${prompt//$'\n'/ }" >> "$STUB_ARGS"

if [[ " $* " == *" --json-schema "* ]]; then
  jq -nc --arg c "$STUB_VERIFY" \
    '{type: "result", subtype: "success", is_error: false}
     + if $c == "" then {} else {structured_output: {command: $c}} end'
  exit 0
fi

# The run skill generator consumes no plan line either. It does what
# $STUB_RUN_SKILL says: `write` writes a run skill, `broken` writes one with a
# file beside it that a test's check reads as red, `committed` is `broken` and
# commits it itself, `stray` writes only a file that is not a run skill, and
# empty writes nothing - a generator that asked which app to run.
if [ "$prompt" = /run-skill-generator ]; then
  top="$(git rev-parse --show-toplevel)"
  case "${STUB_RUN_SKILL:-}" in
    write|broken|committed)
      mkdir -p "$top/.claude/skills/run-app"
      printf -- '---\nname: run-app\n---\n' > "$top/.claude/skills/run-app/SKILL.md"
      [ "$STUB_RUN_SKILL" = write ] || : > "$top/.claude/skills/run-app/broken"
      [ "$STUB_RUN_SKILL" != committed ] || { git -C "$top" add .claude >/dev/null; git -C "$top" commit -qm "run skill"; } ;;
    stray) printf 'notes\n' > "$top/run-notes.txt" ;;
  esac
  echo '{"type":"result","subtype":"success","is_error":false,"result":"done"}'
  exit 0
fi

build_opening="Use /implement-change on the work described in "
split_opening="/split-change-into-chunks on the change in "
review_opening="Review the whole change this run built"
review_named_by="write what you left standing to "

# Reads the chunk or the review's file from where the brief names it on
# purpose: its opening, or the one sentence that names the review's file. The
# rest of the brief may name REVIEW.md too - in a sentence, or in a test's
# check command - and must not change which file the stub writes.
brief_names() {
  local first="${prompt%%$'\n'*}"
  case "$prompt" in
    "$build_opening"*)
      chunk="${first#"$build_opening"}"
      chunk="${chunk%.}" ;;
    "$split_opening"*)
      chunk="${first#"$split_opening"}"
      chunk="${chunk%.}/CHANGE.md" ;;
    "$review_opening"*)
      [[ "$prompt" == *"$review_named_by"* ]] \
        || { echo "stub: the review's brief no longer says \"$review_named_by<path>\": $prompt" >&2; exit 96; }
      review="${prompt#*"$review_named_by"}"
      review="${review%%[[:space:]]*}" ;;
    *) echo "stub: a brief that is neither a build's, the split's nor the review's: $prompt" >&2; exit 96 ;;
  esac
}

chunk=""
review=""
args=("$@")
for i in "${!args[@]}"; do
  case "${args[$i]}" in
    --session-id) brief_names
                  printf 'start %s %s\n' "${args[$((i + 1))]}" "${chunk:-$review}" >> "$STUB_SESSIONS" ;;
    --resume)     id="${args[$((i + 1))]}"
                  printf 'resume %s\n' "$id" >> "$STUB_SESSIONS"
                  chunk="$(awk -v id="$id" '$1 == "start" && $2 == id { print $3 }' "$STUB_SESSIONS")"
                  case "$chunk" in *REVIEW.md) review="$chunk"; chunk="" ;; esac ;;
  esac
done

# One line per call, whitespace flattened, so a test can count calls and read
# the first one to see which chunk went first.
n=$(( $(wc -l < "$STUB_CALLS") + 1 ))
printf '%s\n' "$prompt" | tr '\n' ' ' >> "$STUB_CALLS"
printf '\n' >> "$STUB_CALLS"

line="$(sed -n "${n}p" "$STUB_PLAN")"
[ -n "$line" ] || { echo "stub: no plan line $n for: $prompt" >&2; exit 99; }

echo '{"type":"assistant","message":{"id":"msg_main","content":[],"usage":{"input_tokens":1,"cache_read_input_tokens":10,"cache_creation_input_tokens":100,"output_tokens":5}},"parent_tool_use_id":null}'
echo '{"type":"assistant","message":{"id":"msg_main","content":[],"usage":{"input_tokens":1,"cache_read_input_tokens":10,"cache_creation_input_tokens":100,"output_tokens":5}},"parent_tool_use_id":null}'
echo '{"type":"assistant","message":{"id":"msg_sub","content":[],"usage":{"input_tokens":1000,"cache_read_input_tokens":0,"cache_creation_input_tokens":0,"output_tokens":5}},"parent_tool_use_id":"toolu_sub"}'

# Resetting $STUB_RESET_IN seconds from now, 0 unless a test says otherwise.
rejected_event() {
  printf '{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","resetsAt":%s,"rateLimitType":"five_hour"}}\n' \
    "$(( $(date +%s) + ${STUB_RESET_IN:-0} ))"
}

set_status() { sed -i "2,/^---$/s/^status: .*/status:    $1/" "$chunk"; }

case "$line" in
  review|review-red|review-journey|review-dies|review-stop-early)
    # The final review names no chunk, which is how the stub tells it apart.
    [ -n "$chunk" ] && { echo "stub: expected the review, got a chunk: $prompt" >&2; exit 97; }
    [ "$line" = review-dies ] && exit 1
    if [ "$line" = review-stop-early ]; then
      echo '{"type":"result","subtype":"success","is_error":false,"result":"waiting for critique"}'
      exit 0
    fi
    printf '## For you\n\n1. the review left: a seam\n\n## Findings\n\nthe review'"'"'s detail\n' > "$review"
    git add "$review" >/dev/null 2>&1
    git commit -qm "review" >/dev/null 2>&1
    [ "$line" != review-red ] || : > "$(git rev-parse --show-toplevel)/.red"
    if [ "$line" = review-journey ]; then
      printf '2. a step the review added.\n' >> "$(git rev-parse --show-toplevel)/journeys/one.md"
      git commit -qam "review the journey" >/dev/null 2>&1
    fi
    echo '{"type":"result","subtype":"success","is_error":false,"result":"reviewed"}'
    ;;
  split-none) echo '{"type":"result","subtype":"success","is_error":false,"result":"it fits"}' ;;
  split-two|split-dirty)
    # Two chunks of the change the split was handed, its Problem copied into
    # each word for word, the second after the first.
    dir="$(dirname "$chunk")"
    mkdir -p "$dir/chunks"
    problem="$(sed -n '/^## Problem$/,/^## /{/^## /d;p;}' "$chunk")"
    for c in "1-one journeys/one.md " "2-two journeys/two.md 1-one"; do
      read -r slug journeys after <<< "$c"
      printf -- '---\njourneys:  %s\nafter:     %s\nstatus:    ready\nattempts:  0\n---\n\n# %s\n\n## Problem\n%s\n\n## Design\nx\n' \
        "$journeys" "${after:-}" "$slug" "$problem" > "$dir/chunks/$slug.md"
    done
    if [ "$line" = split-two ]; then
      git add "$dir/chunks" >/dev/null 2>&1
      git commit -qm "split" >/dev/null 2>&1
    fi
    echo '{"type":"result","subtype":"success","is_error":false,"result":"split"}'
    ;;
  build|build-declare|build-journey|limit-passed|build-limit|build-refused|build-dirty|build-killed|build-red|build-red-killed)
    if [ "$line" = limit-passed ]; then
      echo '{"type":"assistant","message":{"role":"assistant","content":[]},"parent_tool_use_id":"toolu_sub","error":"rate_limit"}'
      rejected_event
      echo '{"type":"result","subtype":"success","is_error":false,"result":"built"}'
    fi
    printf '\n## Left standing\n\n- left by %s\n' "$(basename "$chunk")" >> "$chunk"
    [ -z "${STUB_LEFT_EXTRA:-}" ] || cat "$STUB_LEFT_EXTRA" >> "$chunk"
    # shellcheck disable=SC2016 # the backticks are Markdown's, written literally
    [ "$line" != build-declare ] || printf '%s: `%s`\n' "${STUB_DECLARE_AS:-Check}" "$STUB_DECLARE" >> "$(git rev-parse --show-toplevel)/CLAUDE.md"
    [ "$line" != build-journey ] || printf '2. a step the build added.\n' >> "$(git rev-parse --show-toplevel)/journeys/one.md"
    set_status "done"
    git add -A >/dev/null 2>&1
    git commit -qm "build $(basename "$chunk")" >/dev/null 2>&1
    if [ "$line" = build-limit ]; then rejected_event; exit 1; fi
    if [ "$line" = build-refused ]; then
      printf '%s\n' '{"type":"system","subtype":"permission_denied","tool_name":"Bash","tool_use_id":"toolu_2","agent_id":"a1","decision_reason_type":"classifier","decision_reason":"[Irreversible Local Destruction]\nsecond line"}'
      jq -nc --arg f "$(git rev-parse --show-toplevel)/.claude/skills/run/SKILL.md" \
        '{type: "result", subtype: "success", is_error: false, result: "built",
          permission_denials: [
            {tool_name: "Edit", tool_use_id: "toolu_1", tool_input: {file_path: $f, old_string: "a", new_string: "b"}},
            {tool_name: "Bash", tool_use_id: "toolu_2", tool_input: {command: "rm -rf lager/.env\nls", description: "Remove lager"}},
            {tool_name: "Bash", tool_use_id: "toolu_3", tool_input: {command: (("true; " * 30) + "rm -rf /tmp/testakte-*")}}]}'
    fi
    case "$line" in build-red*) : > "$(git rev-parse --show-toplevel)/.red" ;; esac
    if [ "$line" = build-killed ] || [ "$line" = build-red-killed ]; then kill -9 "$PPID"; fi
    if [ "$line" = build-dirty ]; then printf 'stray\n' > "$(git rev-parse --show-toplevel)/stray"; fi
    ;;
  fix-red)
    rm -f "$(git rev-parse --show-toplevel)/.red"
    printf 'fixed\n' >> "$(git rev-parse --show-toplevel)/fix"
    [ -z "$chunk" ] || set_status "done"
    git add -A >/dev/null 2>&1
    git commit -qm "fix $(basename "$chunk")" >/dev/null 2>&1
    ;;
  fix-uncommitted) printf 'fixed\n' > "$(git rev-parse --show-toplevel)/fix" ;;
  claim-only|claim-dirty|claim-killed)
    [ "$line" != claim-dirty ] || printf 'half\n' > "$(git rev-parse --show-toplevel)/code"
    printf 'built\n' >> "$chunk"
    set_status "done"
    [ "$line" != claim-killed ] || kill -9 "$PPID"
    ;;
  code-only)
    printf 'built\n' > code
    git add code >/dev/null 2>&1
    git commit -qm "build $(basename "$chunk")" >/dev/null 2>&1
    set_status "done"
    ;;
  halt:*)
    printf '\n## Halt\n\n%s - the stub was told to\n\nsecond line of the halt\n' "${line#halt:}" >> "$chunk"
    [ -z "${STUB_HALT_EXTRA:-}" ] || cat "$STUB_HALT_EXTRA" >> "$chunk"
    set_status halted
    ;;
  die) exit 1 ;;
  orphaned)
    printf 'half\n' > "$(git rev-parse --show-toplevel)/code"
    kill -9 "$PPID"
    /bin/sleep 3
    ;;
  killed)
    printf 'half\n' > "$(git rev-parse --show-toplevel)/code"
    kill -9 "$PPID"
    ;;
  stop-early) printf 'half\n' > "$(git rev-parse --show-toplevel)/code" ;;
  commit-stop)
    printf 'built\n' > "$(git rev-parse --show-toplevel)/code"
    git add "$(git rev-parse --show-toplevel)/code" >/dev/null 2>&1
    git commit -qm "build $(basename "$chunk")" >/dev/null 2>&1
    ;;
  limit-sub)
    echo '{"type":"assistant","message":{"role":"assistant","content":[]},"parent_tool_use_id":"toolu_sub","error":"rate_limit"}'
    exit 1
    ;;
  limit)
    rejected_event
    echo '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"You'"'"'ve hit your session limit · resets 2:10am (Europe/Amsterdam)"}]},"parent_tool_use_id":null,"error":"rate_limit"}'
    echo '{"type":"result","subtype":"success","is_error":true,"terminal_reason":"api_error","result":"You'"'"'ve hit your session limit · resets 2:10am (Europe/Amsterdam)"}'
    exit 1
    ;;
  limit-quiet) rejected_event; exit 1 ;;
  limit-bare)
    echo '{"type":"assistant","message":{"role":"assistant","content":[]},"parent_tool_use_id":null,"error":"rate_limit"}'
    exit 1
    ;;
  *) echo "stub: bad plan line: $line" >&2; exit 98 ;;
esac
