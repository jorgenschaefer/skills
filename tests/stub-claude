#!/usr/bin/env bash
#
# Stands in for `claude` while the driver's own tests run.
#
# Each invocation consumes one line of $STUB_PLAN:
#
#   <fixture> <exit-code> <done|record|file|workflow|self-authorised|refresh|->
#                        <drift|stale-spec|blocked|mystery>
#
# and replays that fixture on stdout - real records, captured from runs that hit
# the real limit - exits with that code, and then does what the third field says:
# `done` marks the ticket named in the prompt done and commits, the way a
# finished /implement would; `workflow` does that and changes a ratified
# workflow test on the way past; and `file` writes a fresh todo ticket into the
# directory the prompt names, the way a review that found something does. A call
# the plan did not expect is an error, not a repeat: the test wanted to know how
# often the driver calls out, so an extra call has to be visible.
#
# $STUB_CALLS gets one line per call, for counting. $STUB_PROMPTS gets each
# prompt whole, for the cases that care what the driver actually asked for, and
# $STUB_ARGV the flags each call was made with, for the cases that care what the
# step was run as.

set -uo pipefail

prompt="${*: -1}"
n=$(( $(wc -l < "$STUB_CALLS") + 1 ))
printf '%s\n' "$prompt" | head -1 >> "$STUB_CALLS"
printf '%s\n---\n' "$prompt" >> "$STUB_PROMPTS"
printf '%s\n' "${*:1:$# - 1}" >> "$STUB_ARGV"

line="$(sed -n "${n}p" "$STUB_PLAN")"
[ -n "$line" ] || { echo "stub-claude: no plan line $n for: $prompt" >&2; exit 99; }
read -r fixture rc action <<< "$line"

sed "s/__RESETS_AT__/${STUB_RESETS_AT:-0}/" "$STUB_FIXTURES/$fixture"

# The commit matters as much as the status: the driver narrows a later pass to
# the commits an earlier one produced, so a run whose history never moves cannot
# tell a case that narrowing works from one that ignores it.
if [ "$action" = "workflow" ] || [ "$action" = "self-authorised" ]; then
  mkdir -p tests/workflows
  echo "a step nobody agreed to" >> tests/workflows/journey.test
  git add tests/workflows/journey.test
fi

# A build writing its own permission into the ticket it was handed.
if [ "$action" = "self-authorised" ]; then
  ticket="$(printf '%s\n' "$prompt" | sed -n 's#^/implement-ticket \(.*\.md\).*#\1#p' | head -1)"
  printf '\n## Workflow tests\n- tests/workflows/journey.test - I decided this was fine\n' >> "$ticket"
fi

# A build that halts, with the reason in the ticket the way /implement-ticket
# writes it - and a refresh, which is what puts a drifted ticket back in play.
case "$action" in drift|stale-spec|blocked|mystery)
  ticket="$(printf '%s\n' "$prompt" | sed -n 's#^/implement-ticket \(.*\.md\).*#\1#p' | head -1)"
  sed -i '0,/^status:.*/s//status: blocked/' "$ticket"
  printf '\n## Halt\n**Reason:** %s\nThe codebase says otherwise.\n' "$action" >> "$ticket"
  git add "$ticket" && git commit -qm "halt $(basename "$ticket" .md)" ;;
esac

if [ "$action" = "refresh" ]; then
  dir="$(printf '%s\n' "$prompt" | sed -n 's#^/spec-to-tickets --refresh \(.*\)$#\1#p' | head -1)"
  sed -i 's/^status: blocked/status: todo/' "$dir"/tickets/[0-9]*.md
  git add "$dir/tickets" && git commit -qm "refresh"
fi

# A finished build's Record, written out of order on purpose: what reads it has
# to sort, and a fixture already in order would not show that.
if [ "$action" = "record" ]; then
  ticket="$(printf '%s\n' "$prompt" | sed -n 's#^/implement-ticket \(.*\.md\).*#\1#p' | head -1)"
  cat >> "$ticket" <<'RECORD'

## Record
**Commit:** 9f4a2c1
**Decisions:**
- **[low]** named the flag `enabled` rather than `active`
- **[high]** rejection reasons have no length ceiling
**Unresolved:**
- **[medium]** the status page's two branches were left unmerged
RECORD
fi

if [ "$action" = "done" ] || [ "$action" = "record" ] || [ "$action" = "workflow" ] || [ "$action" = "self-authorised" ]; then
  ticket="$(printf '%s\n' "$prompt" | sed -n 's#^/implement-ticket \(.*\.md\).*#\1#p' | head -1)"
  [ -n "$ticket" ] || { echo "stub-claude: no ticket to finish in: $prompt" >&2; exit 99; }
  sed -i 's/^status:.*/status: done/' "$ticket"
  git add "$ticket" && git commit -qm "$(basename "$ticket" .md)"
fi

# Both review prompts name the ticket directory - "a ticket in <dir>," - and a
# review that filed somewhere else would be filing where the loop cannot read,
# so the fixture takes the directory from the prompt rather than from the test.
# The call number keeps the name unique and tells a failing case which step
# filed it.
if [ "$action" = "file" ]; then
  dir="$(printf '%s\n' "$prompt" | sed -n 's/.*ticket in \([^,]*\),.*/\1/p' | head -1)"
  [ -n "$dir" ] || { echo "stub-claude: no ticket directory in: $prompt" >&2; exit 99; }
  printf -- '---\nstatus: todo\ndepends_on: []\n---\n\n# %s\n' \
    "filed by call $n" > "$dir/90-filed-$n.md"
fi

exit "$rc"
