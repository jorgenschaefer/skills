#!/usr/bin/env bash
#
# Stands in for `claude` while the driver's own tests run.
#
# Each invocation consumes one line of $STUB_PLAN:
#
#   <fixture> <exit-code> <done|->
#
# and replays that fixture on stdout - real records, captured from runs that hit
# the real limit - exits with that code, and, when the third field says `done`,
# marks the ticket named in the prompt done, the way a finished /implement would.
# A call the plan did not expect is an error, not a repeat: the test wanted to
# know how often the driver calls out, so an extra call has to be visible.

set -uo pipefail

prompt="${*: -1}"
n=$(( $(wc -l < "$STUB_CALLS") + 1 ))
printf '%s\n' "$prompt" | head -1 >> "$STUB_CALLS"

line="$(sed -n "${n}p" "$STUB_PLAN")"
[ -n "$line" ] || { echo "stub-claude: no plan line $n for: $prompt" >&2; exit 99; }
read -r fixture rc action <<< "$line"

sed "s/__RESETS_AT__/${STUB_RESETS_AT:-0}/" "$STUB_FIXTURES/$fixture"

if [ "$action" = "done" ]; then
  ticket="$(printf '%s\n' "$prompt" | sed -n 's#^/implement \(.*\.md\).*#\1#p' | head -1)"
  [ -n "$ticket" ] && sed -i 's/^status:.*/status: done/' "$ticket"
fi

exit "$rc"
